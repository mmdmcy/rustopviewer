[Unit]
Description=RustOp Viewer persistent Masterdale remote control
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/rustopviewer/masterdale.env
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/.local/bin/rustopviewer --headless
Restart=on-failure
RestartSec=3
Nice=5

[Install]
WantedBy=default.target
