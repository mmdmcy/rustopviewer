# Copy to .private/rustopviewer.env and keep the real file private.
#
# ROV_DEVICE_CODE is the stable code shown in the browser dashboard.
# It is an identifier, not a secret.
ROV_DEVICE_CODE=WORKSTATION-01

# ROV_ACCESS_PASSWORD is the long unattended-login password.
# Use a unique random value. It is hashed into the app config on startup.
ROV_ACCESS_PASSWORD=replace-with-a-long-unique-password

# ROV_ADMIN_TOKEN protects the loopback-only /api/admin/* JSON endpoints.
# Open /admin?token=... once, or paste it into the admin page token field.
ROV_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Optional: accept the same bearer token as Masterdale for persistent view/control.
# ROV_MASTERDALE_TOKEN takes precedence; DALE_TOKEN is also accepted from the process environment.
ROV_MASTERDALE_TOKEN=replace-with-your-masterdale-token

# Optional LinuxMice OIDC. Set all five together. Allowed subjects are
# comma-separated LinuxMice user UUIDs; remote control is owner-allowlisted.
ROV_OIDC_ISSUER=https://identity.example.test
ROV_OIDC_CLIENT_ID=rustopviewer
ROV_OIDC_CLIENT_SECRET=replace-with-registered-client-secret
ROV_OIDC_REDIRECT_URL=https://rustopviewer.example.test/auth/oidc/callback
ROV_OIDC_ALLOWED_SUBJECTS=replace-with-linuxmice-owner-uuid
