# Copy to .private/rustopviewer.env and keep the real file private.
#
# ROV_DEVICE_CODE is the stable code shown in the browser dashboard.
# It is an identifier, not a secret.
ROV_DEVICE_CODE=WORKSTATION-01

# ROV_ACCESS_PASSWORD is the long unattended-login password.
# Use a unique random value. It is hashed into the app config on startup.
ROV_ACCESS_PASSWORD=replace-with-a-long-unique-password

# ROV_ADMIN_TOKEN protects the loopback-only /api/admin/* JSON endpoints.
# Open /admin?token=... once, or paste it into the admin page token field.
ROV_ADMIN_TOKEN=replace-with-a-long-random-admin-token
